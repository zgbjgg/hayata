{erl_opts, [debug_info]}.
{deps, [
    {telemetry, "1.4.2"}
]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [hayata]}
]}.

{plugins, [coveralls, rebar3_codecov, rebar3_hex]}.

{cover_enabled, true}.
{cover_export_enabled, true}.

{provider_hooks, [
    {post, [{eunit, {codecov, analyze}}]}
]}.

{pkg, [
    {name, hayata},
    {description, "An Erlang/OTP framework for building AI agents."},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/zgbjgg/hayata"}
    ]}
]}.

{hex, [{doc, edoc}]}.
