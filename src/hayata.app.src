{application, hayata, [
    {description, "An Erlang/OTP framework for building AI agents."},
    {vsn, "2.0.1"},
    {registered, [
        hayata_sup
    ]},
    {mod, {hayata_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        telemetry
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/zgbjgg/hayata"}
    ]},
    {files, [
        "src/*",
        "compat/json.erl",
        "rebar.config",
        "rebar.config.script",
        "rebar.lock",
        "README.md",
        "LICENSE.md"
    ]}
]}.
